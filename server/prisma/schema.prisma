generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "mysql"    
}

model Users {
    id              String             @id @default(uuid())
    name            String
    email           String             @unique
    password        String
    questions       Questions[]
    comments        Comments[]
    questionUpvotes QuestionUpvotes[]
    commentUpvotes  CommentUpvotes[]
}

model Questions {
    id          String             @id @default(uuid())
    userId      String
    title       String
    description String
    imageData   Bytes?
    createdAt   DateTime           @default(now())
    upvotes     Int                @default(0)
    comments    Comments[]
    upvotedBy   QuestionUpvotes[]
    user        Users              @relation(fields: [userId], references: [id])
}

model Comments {
    id          String           @id @default(uuid())
    questionId  String
    userId      String
    text        String
    createdAt   DateTime         @default(now())
    upvotes     Int              @default(0)
    question    Questions        @relation(fields: [questionId], references: [id])
    user        Users            @relation(fields: [userId], references: [id])
    upvotedBy   CommentUpvotes[]
}

model QuestionUpvotes {
    id         String    @id @default(uuid())
    userId     String
    questionId String
    createdAt  DateTime  @default(now())
    user       Users     @relation(fields: [userId], references: [id])
    question   Questions @relation(fields: [questionId], references: [id])

    @@unique([userId, questionId])
}

model CommentUpvotes {
    id        String   @id @default(uuid())
    userId    String
    commentId String
    createdAt DateTime @default(now())
    user      Users    @relation(fields: [userId], references: [id])
    comment   Comments @relation(fields: [commentId], references: [id])

    @@unique([userId, commentId])
}

model PendingPasswordReset {
    id        String   @id @default(uuid())
    email     String
    token     String   @unique
    createdAt DateTime @default(now())
    expiresAt DateTime
}
