generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "mysql"    
}

model Users {
    id            String          @id @default(uuid())
    name          String
    email         String          @unique
    password      String
    questions     Questions[]
    comments      Comments[]
    questionVotes QuestionVotes[]
    commentVotes  CommentVotes[]

    @@map("users")
}

model Questions {
    id          String          @id @default(uuid())
    userId      String
    title       String
    description String
    imageData   Bytes?
    createdAt   DateTime        @default(now())
    votes       Int             @default(0) @map("upvotes")
    comments    Comments[]
    votedBy     QuestionVotes[]
    user        Users           @relation(fields: [userId], references: [id])

    @@map("questions")
}

model Comments {
    id         String         @id @default(uuid())
    questionId String
    userId     String
    text       String
    createdAt  DateTime       @default(now())
    votes      Int            @default(0) @map("upvotes")
    question   Questions      @relation(fields: [questionId], references: [id])
    user       Users          @relation(fields: [userId], references: [id])
    votedBy    CommentVotes[]

    @@map("comments")
}

model QuestionVotes {
    id         String    @id @default(uuid())
    userId     String
    questionId String
    isUpvote   Boolean
    createdAt  DateTime  @default(now())
    user       Users     @relation(fields: [userId], references: [id])
    question   Questions @relation(fields: [questionId], references: [id])

    @@unique([userId, questionId])
    @@map("questionupvotes")
}

model CommentVotes {
    id        String   @id @default(uuid())
    userId    String
    commentId String
    isUpvote  Boolean
    createdAt DateTime @default(now())
    user      Users    @relation(fields: [userId], references: [id])
    comment   Comments @relation(fields: [commentId], references: [id])

    @@unique([userId, commentId])
    @@map("commentupvotes")
}

model PendingPasswordReset {
    id        String   @id @default(uuid())
    email     String
    token     String   @unique
    createdAt DateTime @default(now())
    expiresAt DateTime

    @@map("pendingpasswordreset")
}
