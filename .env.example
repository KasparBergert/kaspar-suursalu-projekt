
DB_PASS=your-mariadb-password
DB_NAME=quora_clone
DATABASE_URL=mysql://root:your-mariadb-password@localhost:3306/quora_clone

DB_CONNECTION_LIMIT=10
JWT_SECRET=change-me
# you can leave this unchanged if the process is run localhost
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000/api

# Password reset emails are sent to local Mailpit by default in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Quora Copy <no-reply@localhost>"

# For a real SMTP provider, set these too.
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
